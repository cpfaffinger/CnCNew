<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- The pure parts of the baseline manifests live in the tool; they are compiled into the tests as source (no reference to an executable, no new dependency). -->
    <Compile Include="../../tools/CnCNew.SimTool/ManifestDocument.cs" Link="Linked/ManifestDocument.cs" />
    <Compile Include="../../tools/CnCNew.SimTool/CanonicalObjectHasher.cs" Link="Linked/CanonicalObjectHasher.cs" />
    <Compile Include="../../tools/CnCNew.SimTool/PerfSummary.cs" Link="Linked/PerfSummary.cs" />
    <Compile Include="../../tools/CnCNew.SimTool/RateDistribution.cs" Link="Linked/RateDistribution.cs" />
    <!-- The product's default rate is defined once, in the game layer; this project does not reference that layer and takes the definition as source. -->
    <Compile Include="../../src/CnCNew.Game/Data/ProductRate.cs" Link="Linked/ProductRate.cs" />
    <!-- The synthetic skirmish fixture is shared with the network tests. -->
    <Compile Include="../Shared/SkirmishFixtureFiles.cs" Link="Shared/SkirmishFixtureFiles.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CnCNew.Content/CnCNew.Content.csproj" />
    <ProjectReference Include="../../src/CnCNew.Data/CnCNew.Data.csproj" />
    <ProjectReference Include="../../src/CnCNew.Formats/CnCNew.Formats.csproj" />
    <ProjectReference Include="../../src/CnCNew.Simulation/CnCNew.Simulation.csproj" />
  </ItemGroup>
</Project>
