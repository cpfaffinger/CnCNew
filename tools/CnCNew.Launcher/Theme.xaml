<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The palette of the modern skin of the game (docs/UI-MODERN.md section 5): dark and cool, one warm accent. -->
    <Color x:Key="CanvasColor">#0F141B</Color>
    <Color x:Key="PanelColor">#18202A</Color>
    <Color x:Key="ControlColor">#243041</Color>
    <Color x:Key="HoverColor">#2F4058</Color>
    <Color x:Key="SelectedColor">#2D4F7C</Color>
    <Color x:Key="BorderColor">#3C4A5E</Color>
    <Color x:Key="AccentColor">#F2B33D</Color>
    <Color x:Key="AccentLightColor">#FFD278</Color>
    <Color x:Key="AccentDarkColor">#D68C1E</Color>
    <Color x:Key="TextColor">#EEF1F5</Color>
    <Color x:Key="MutedColor">#A9B4C2</Color>
    <Color x:Key="DisabledColor">#768292</Color>
    <Color x:Key="GoodColor">#7EDC8A</Color>
    <Color x:Key="BadColor">#FF7A66</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}"/>
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}"/>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}"/>
    <SolidColorBrush x:Key="BadSoftBrush" Color="#33FF7A66"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#26F2B33D"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentLightColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentColor}" Offset="0.5"/>
        <GradientStop Color="{StaticResource AccentDarkColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFE3A0" Offset="0"/>
        <GradientStop Color="#FFC24F" Offset="0.5"/>
        <GradientStop Color="#E39A2B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1C2633" Offset="0"/>
        <GradientStop Color="#141B24" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#141C27" Offset="0"/>
        <GradientStop Color="#0D1218" Offset="0.6"/>
        <GradientStop Color="#0A0E13" Offset="1"/>
    </LinearGradientBrush>

    <!-- A faint map grid behind everything. -->
    <DrawingBrush x:Key="GridBrush" TileMode="Tile" Viewport="0,0,44,44" ViewportUnits="Absolute" Viewbox="0,0,44,44" ViewboxUnits="Absolute" Opacity="0.55">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Brush="#12FFFFFF" Thickness="1"/>
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="44,0"/>
                        <LineGeometry StartPoint="0,0" EndPoint="0,44"/>
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Glyphs, drawn as paths (no icon font, no image). -->
    <Geometry x:Key="CheckGlyph">M2,8 L6,12 L14,3</Geometry>
    <Geometry x:Key="CrossGlyph">M3,3 L13,13 M13,3 L3,13</Geometry>
    <Geometry x:Key="WarnGlyph">M8,2 L8,10 M8,13 L8,13.5</Geometry>
    <Geometry x:Key="PlayGlyph">M6,3 L19,11 L6,19 Z</Geometry>
    <Geometry x:Key="GearGlyph">M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 M10.3,2.5 L13.7,2.5 L14.3,5.1 L16.1,5.9 L18.3,4.4 L20.6,6.7 L19.1,8.9 L19.9,10.7 L22.5,11.3 L22.5,14.7 L19.9,15.3 L19.1,17.1 L20.6,19.3 L18.3,21.6 L16.1,20.1 L14.3,20.9 L13.7,23.5 L10.3,23.5 L9.7,20.9 L7.9,20.1 L5.7,21.6 L3.4,19.3 L4.9,17.1 L4.1,15.3 L1.5,14.7 L1.5,11.3 L4.1,10.7 L4.9,8.9 L3.4,6.7 L5.7,4.4 L7.9,5.9 L9.7,5.1 Z</Geometry>
    <Geometry x:Key="MinimizeGlyph">M0,0 L10,0</Geometry>
    <Geometry x:Key="CloseGlyph">M0,0 L10,10 M10,0 L0,10</Geometry>
    <Geometry x:Key="FolderGlyph">M2,5 L8,5 L10,7 L20,7 L20,18 L2,18 Z</Geometry>
    <Geometry x:Key="DownloadGlyph">M11,3 L11,14 M6,10 L11,15 L16,10 M4,19 L18,19</Geometry>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Headline" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style x:Key="Lead" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="LineHeight" Value="21"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <!-- Buttons: the primary one is the accent, the ghost ones are quiet. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#1A1305"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="28,0"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{StaticResource AccentGradient}" CornerRadius="8" BorderBrush="#66FFFFFF" BorderThickness="0,1,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#F2B33D" BlurRadius="22" ShadowDepth="0" Opacity="0.28"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource AccentGradientHover}"/>
                            <Setter TargetName="Face" Property="Effect">
                                <Setter.Value><DropShadowEffect Color="#F2B33D" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ControlBrush}"/>
                            <Setter TargetName="Face" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Face" Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Foreground" Value="{StaticResource DisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{StaticResource ControlBrush}" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SelectedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledBrush}"/>
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource PanelBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
    </Style>

    <!-- The round window buttons in the title bar. -->
    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#26FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#E5C42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="5" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Path x:Name="Tick" Data="{StaticResource CheckGlyph}" Stroke="#1A1305" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Margin="4" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BigProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="14"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="7" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                        <Border x:Name="PART_Indicator" CornerRadius="7" HorizontalAlignment="Left" Background="{StaticResource AccentGradient}" Margin="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#F2B33D" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Width="8">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource BorderBrush}" CornerRadius="4" Margin="1,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
