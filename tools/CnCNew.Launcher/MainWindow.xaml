<Window x:Class="CnCNew.Launcher.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:CnCNew.Launcher.Shell"
        Title="CnCNew Launcher" Width="1000" Height="700" ResizeMode="CanMinimize" WindowStyle="None"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" Icon="Assets/launcher.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- One row of the step list on the left. -->
        <DataTemplate x:Key="StepTemplate" DataType="{x:Type shell:StepItem}">
            <Grid Margin="0,0,0,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="24" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0">
                    <Ellipse x:Name="Ring" Stroke="{StaticResource BorderBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                    <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    <Path x:Name="Tick" Data="{StaticResource CheckGlyph}" Stroke="#1A1305" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed"/>
                </Grid>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="14" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="Detail" Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0" Opacity="0.85"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="Ring" Property="Fill" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Num" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource TextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Skipped">
                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Tick" Property="Stroke" Value="{StaticResource MutedBrush}"/>
                    <Setter TargetName="Num" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Ring" Property="Fill" Value="{StaticResource AccentSoftBrush}"/>
                    <Setter TargetName="Num" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource BadBrush}"/>
                    <Setter TargetName="Ring" Property="Fill" Value="{StaticResource BadSoftBrush}"/>
                    <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BadBrush}"/>
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource BadBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One row of the checks on the first page. -->
        <DataTemplate x:Key="CheckTemplate" DataType="{x:Type shell:CheckItem}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="22" Height="22" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0">
                    <Ellipse x:Name="Badge" Fill="{StaticResource GoodBrush}"/>
                    <Path x:Name="Mark" Data="{StaticResource CheckGlyph}" Stroke="#0B1A0E" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="11" Height="11" Stretch="Uniform"/>
                </Grid>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Detail" Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0" LineHeight="17"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter TargetName="Badge" Property="Fill" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Mark" Property="Data" Value="{StaticResource WarnGlyph}"/>
                    <Setter TargetName="Mark" Property="Stroke" Value="#1A1305"/>
                    <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource TextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Badge" Property="Fill" Value="{StaticResource BadBrush}"/>
                    <Setter TargetName="Mark" Property="Data" Value="{StaticResource CrossGlyph}"/>
                    <Setter TargetName="Mark" Property="Stroke" Value="#2A0A05"/>
                    <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource TextBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource WindowGradient}">
        <Grid>
            <Rectangle Fill="{StaticResource GridBrush}" IsHitTestVisible="False"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="38"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <shell:Emblem Width="28" Height="28"/>
                        <TextBlock Text="CnCNew" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Launcher" FontSize="16" Foreground="{StaticResource MutedBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ChromeButton}" Command="{Binding ToggleSettingsCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Settings">
                            <Path Data="{StaticResource GearGlyph}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" StrokeLineJoin="Round"/>
                        </Button>
                        <Button x:Name="MinimizeButton" Style="{StaticResource ChromeButton}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize">
                            <Path Data="{StaticResource MinimizeGlyph}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="10" Height="10" Stretch="Fill"/>
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
                            <Path Data="{StaticResource CloseGlyph}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="10" Height="10" Stretch="Fill"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Update banner -->
                <Border Grid.Row="1" Visibility="{Binding UpdateVisible, Converter={StaticResource B2V}}" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,1,0,1" Padding="28,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource DownloadGlyph}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" Width="20" Height="20" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding UpdateText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" ToolTip="{Binding UpdateNotes}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Update now" Style="{StaticResource GhostButton}" Command="{Binding UpdateCommand}" Height="32" Margin="0,0,8,0" BorderBrush="{StaticResource AccentBrush}" Foreground="{StaticResource AccentBrush}"/>
                            <Button Content="Not now" Style="{StaticResource GhostButton}" Command="{Binding DismissUpdateCommand}" Height="32" Margin="0,0,8,0"/>
                            <Button Content="Skip this version" Style="{StaticResource GhostButton}" Command="{Binding SkipUpdateCommand}" Height="32"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main area -->
                <Grid Grid.Row="2" Margin="28,18,28,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left card: emblem and the steps -->
                    <Border Background="{StaticResource CardGradient}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="26,22,22,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <shell:Emblem Width="96" Height="96" HorizontalAlignment="Center"/>
                                <TextBlock Text="CnCNew" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="A new engine for Command &amp; Conquer: Generals - Zero Hour" Style="{StaticResource Caption}" TextAlignment="Center" Margin="6,6,6,0"/>
                                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,16,0,18" Opacity="0.7"/>
                            </StackPanel>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepTemplate}" Focusable="False">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                            <StackPanel Grid.Row="1" VerticalAlignment="Top" Visibility="{Binding IsReady, Converter={StaticResource B2V}}">
                                <TextBlock Text="INSTALLED" Style="{StaticResource Section}"/>
                                <TextBlock Text="{Binding InstalledText}" FontSize="14" Margin="0,6,0,0"/>
                                <TextBlock Text="IN THIS FOLDER" Style="{StaticResource Section}" Margin="0,18,0,0"/>
                                <TextBlock Text="{Binding InstallFolder}" Style="{StaticResource Caption}" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right card: the page -->
                    <Border Grid.Column="2" Background="{StaticResource CardGradient}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="34,30,34,28">
                        <Grid>
                            <!-- Starting -->
                            <StackPanel Visibility="{Binding IsStarting, Converter={StaticResource B2V}}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Headline}" Style="{StaticResource Headline}"/>
                                <TextBlock Text="{Binding Lead}" Style="{StaticResource Lead}" Margin="0,8,0,22"/>
                                <ProgressBar Style="{StaticResource BigProgress}" Value="0.12"/>
                            </StackPanel>

                            <!-- Welcome: the checks, the folder, the install button -->
                            <Grid Visibility="{Binding IsWelcome, Converter={StaticResource B2V}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Headline}"/>
                                    <TextBlock Text="{Binding Lead}" Style="{StaticResource Lead}" Margin="0,8,0,18"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="YOUR COMPUTER" Style="{StaticResource Section}" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource CheckTemplate}" Focusable="False"/>
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel Grid.Row="3">
                                    <TextBlock Text="INSTALL FOLDER" Style="{StaticResource Section}" Margin="0,12,0,8"/>
                                    <Border Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,6,6,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding InstallFolder}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                            <Button Grid.Column="1" Content="Change..." Style="{StaticResource GhostButton}" Command="{Binding ChangeFolderCommand}" Height="30" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <CheckBox IsChecked="{Binding VerifySimulation}" Margin="0,12,0,0">
                                        <TextBlock Text="Also check that this computer plays the game exactly like the reference computer (optional, a few minutes)" Style="{StaticResource Caption}" Foreground="{StaticResource TextBrush}" LineHeight="17"/>
                                    </CheckBox>
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ReleaseLine}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <Button Grid.Column="1" Content="Check again" Style="{StaticResource GhostButton}" Command="{Binding RecheckCommand}" Height="52" Margin="0,0,12,0"/>
                                        <Button Grid.Column="2" Content="Install" Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" MinWidth="190"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Installing -->
                            <Grid Visibility="{Binding IsInstalling, Converter={StaticResource B2V}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Headline}"/>
                                    <TextBlock Text="{Binding Lead}" Style="{StaticResource Lead}" Margin="0,8,0,26" MinHeight="44"/>
                                    <ProgressBar Style="{StaticResource BigProgress}" Value="{Binding Progress, Mode=OneWay}" Height="16"/>
                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                    <TextBlock Text="You can leave this window open and do something else. Nothing is changed in your Steam copy." Style="{StaticResource Caption}" Margin="0,28,0,0"/>
                                </StackPanel>
                                <Button Grid.Row="1" Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" HorizontalAlignment="Right" Height="40"/>
                            </Grid>

                            <!-- Ready -->
                            <Grid Visibility="{Binding IsReady, Converter={StaticResource B2V}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Headline}" FontSize="34"/>
                                    <TextBlock Text="{Binding Lead}" Style="{StaticResource Lead}" Margin="0,10,0,34"/>
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding PlayCommand}" Height="76" HorizontalAlignment="Left" MinWidth="330">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource PlayGlyph}" Fill="#1A1305" Width="22" Height="22" Stretch="Uniform"/>
                                            <TextBlock Text="PLAY" FontSize="24" FontWeight="Bold" Foreground="#1A1305" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <Button Content="Check every file" Style="{StaticResource GhostButton}" Command="{Binding RepairCommand}" Margin="0,0,10,0"/>
                                    <Button Content="Open the game folder" Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,10,0"/>
                                    <Button Content="Settings" Style="{StaticResource GhostButton}" Command="{Binding ToggleSettingsCommand}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Failed -->
                            <Grid Visibility="{Binding IsFailed, Converter={StaticResource B2V}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Headline}" Style="{StaticResource Headline}"/>
                                <Border Grid.Row="1" Background="{StaticResource BadSoftBrush}" BorderBrush="{StaticResource BadBrush}" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,18,0,18" VerticalAlignment="Top">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                        <TextBlock Text="{Binding Failure}" FontSize="14" LineHeight="21"/>
                                    </ScrollViewer>
                                </Border>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Open the log" Style="{StaticResource GhostButton}" Command="{Binding OpenLogCommand}" Height="44" Margin="0,0,12,0"/>
                                    <Button Content="Try again" Style="{StaticResource PrimaryButton}" Command="{Binding RetryCommand}" Height="44" FontSize="14" MinWidth="150"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="3" Margin="30,0,30,0">
                    <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="560" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="NoWrap" Opacity="0.8">
                        <Run Text="Unofficial community project. Needs your own copy of the game."/>
                        <Run Text="   "/>
                        <Run Text="{Binding LauncherVersion, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- Scrim and the settings flyout -->
            <Rectangle x:Name="Scrim" Fill="#99000000" Margin="0,52,0,0" MouseLeftButtonDown="OnScrimClick">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SettingsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
            <Border Width="380" HorizontalAlignment="Right" Margin="0,52,0,0" Background="#FF141B24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0" Padding="28,24">
                <Border.RenderTransform>
                    <TranslateTransform X="380"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SettingsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="380" To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource Headline}" FontSize="22"/>
                    <TextBlock Text="INSTALL FOLDER" Style="{StaticResource Section}" Margin="0,24,0,8"/>
                    <TextBlock Text="{Binding InstallFolder}" FontSize="13" Margin="0,0,0,10"/>
                    <Button Content="Choose another folder..." Style="{StaticResource GhostButton}" Command="{Binding ChangeFolderCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="The game is made again in the new folder. The old one stays until you delete it." Style="{StaticResource Caption}" Margin="0,8,0,0"/>

                    <TextBlock Text="UPDATES" Style="{StaticResource Section}" Margin="0,26,0,10"/>
                    <CheckBox IsChecked="{Binding CheckForUpdates}">
                        <TextBlock Text="Look for a new version when the launcher starts" FontSize="13"/>
                    </CheckBox>

                    <TextBlock Text="SIMULATION CHECK" Style="{StaticResource Section}" Margin="0,26,0,10"/>
                    <CheckBox IsChecked="{Binding VerifySimulation}">
                        <TextBlock Text="After installing, compare the game with the reference values (off by default)" FontSize="13" LineHeight="18"/>
                    </CheckBox>
                    <TextBlock Text="{Binding SimulationNote}" Style="{StaticResource Caption}" Margin="30,6,0,0"/>

                    <TextBlock Text="MAINTENANCE" Style="{StaticResource Section}" Margin="0,26,0,10"/>
                    <WrapPanel>
                        <Button Content="Check every file" Style="{StaticResource GhostButton}" Command="{Binding RepairCommand}" Margin="0,0,8,8"/>
                        <Button Content="Open the log" Style="{StaticResource GhostButton}" Command="{Binding OpenLogCommand}" Margin="0,0,8,8"/>
                        <Button Content="Remove the game..." Style="{StaticResource DangerButton}" Command="{Binding UninstallCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,22,0,0" LineHeight="17"
                               Text="Your saved games and settings are kept in your user profile and stay when the game is removed. Steam's copy of the game is only ever read. No data is sent anywhere; the launcher only asks GitHub for the newest release."/>
                </StackPanel>
            </Border>

            <!-- Confirmation -->
            <Grid Visibility="{Binding ConfirmOpen, Converter={StaticResource B2V}}">
                <Rectangle Fill="#B3000000"/>
                <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#FF18202A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="28,24">
                    <StackPanel>
                        <TextBlock Text="Are you sure?" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ConfirmText}" Style="{StaticResource Lead}" Margin="0,10,0,22"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Keep it" Style="{StaticResource GhostButton}" Command="{Binding ConfirmNoCommand}" Margin="0,0,10,0"/>
                            <Button Content="Remove" Style="{StaticResource DangerButton}" Command="{Binding ConfirmYesCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
