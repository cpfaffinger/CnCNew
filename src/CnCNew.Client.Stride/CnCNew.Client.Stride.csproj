<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <StridePlatform>Windows</StridePlatform>
    <StrideGraphicsApi>Direct3D11</StrideGraphicsApi>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Stride's build-only asset compiler currently restores audited transitive tooling packages. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1903</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stride.Core.Assets.CompilerApp"
                      Version="4.3.0.2507"
                      PrivateAssets="contentfiles;analyzers"
                      IncludeAssets="build" />
    <PackageReference Include="Stride.Engine" Version="4.3.0.2507" />
    <ProjectReference Include="../CnCNew.Content/CnCNew.Content.csproj" />
    <ProjectReference Include="../CnCNew.Images/CnCNew.Images.csproj" />
    <ProjectReference Include="../CnCNew.W3D/CnCNew.W3D.csproj" />
    <ProjectReference Include="../CnCNew.Data/CnCNew.Data.csproj" />
    <ProjectReference Include="../CnCNew.Simulation/CnCNew.Simulation.csproj" />
    <ProjectReference Include="../CnCNew.Presentation/CnCNew.Presentation.csproj" />
    <ProjectReference Include="../CnCNew.Ui/CnCNew.Ui.csproj" />
    <ProjectReference Include="../CnCNew.Audio/CnCNew.Audio.csproj" />
    <ProjectReference Include="../CnCNew.Game/CnCNew.Game.csproj" />
  </ItemGroup>
</Project>

